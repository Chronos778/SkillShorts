# Clerk Configuration (Vite uses VITE_ prefix, not NEXT_PUBLIC_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note: The SUPABASE_SERVICE_ROLE_KEY is for server-side only (Next.js)
# For client-side React/Vite, you need the ANON KEY from your Supabase project:
# Go to Supabase Dashboard > Settings > API > Project API keys > anon (public)
